# ============================================================
# eGlobe Review Management System — Backend Environment
# Copy this file to .env and fill in your values
# ============================================================

# ── Server ─────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Microsoft SQL Server 2022 ───────────────────────────────
# Format: sqlserver://HOST:PORT;database=DB_NAME;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
#
# Local Docker (from docker-compose):
DATABASE_URL="sqlserver://localhost:1434;database=eglobe_reviews;user=sa;password=eGlobe@StrongPass2024!;encrypt=true;trustServerCertificate=true"
#
# Azure SQL Database:
# DATABASE_URL="sqlserver://yourserver.database.windows.net:1433;database=eglobe_reviews;user=sqladmin;password=YourPassword;encrypt=true"
#
# SQL Server on a remote host:
# DATABASE_URL="sqlserver://192.168.1.100:1433;database=eglobe_reviews;user=sa;password=YourPassword;encrypt=false;trustServerCertificate=true"

# SA password (used by Docker Compose SQL Server container)
MSSQL_SA_PASSWORD=eGlobe@StrongPass2024!
MSSQL_HOST_PORT=1434

# ── JWT Authentication ──────────────────────────────────────
JWT_SECRET=eglobe_super_secret_jwt_key_change_this_in_production_2024
JWT_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Google Business Profile API ────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
GOOGLE_PLACE_ID=your_google_place_id
GOOGLE_BUSINESS_ACCOUNT_ID=accounts/your_account_id
GOOGLE_LOCATION_ID=locations/your_location_id
# API Key (for Places API)
GOOGLE_API_KEY=your_google_api_key

# ── OpenAI ─────────────────────────────────────────────────
# Leave blank to use built-in reply templates (no API key needed)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Encryption (for storing OAuth tokens in DB) ─────────────
ENCRYPTION_KEY=32_character_random_string_here!!

# ── Email / SMTP ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@eglobe.com

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info

# ── Redis (BullMQ queues + Socket.io adapter) ──────────────
# Local Docker Redis:
REDIS_URL=redis://localhost:6379
# Redis with password:
# REDIS_URL=redis://:your_redis_password@localhost:6379

# ── Stripe Billing ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── App URL (used in Stripe redirects, emails) ─────────────
APP_URL=http://localhost:3000

# ── Socket.io ──────────────────────────────────────────────
# No extra config needed — Socket.io uses FRONTEND_URL for CORS
